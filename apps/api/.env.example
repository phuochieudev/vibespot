NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# Neon Postgres. DATABASE_URL: chuỗi pooled (dùng khi chạy app).
# DIRECT_URL: chuỗi direct, không qua pooler (tuỳ chọn, dùng cho prisma migrate).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# DIRECT_URL=postgresql://USER:PASSWORD@HOST-direct/DB?sslmode=require

# Điền ở bước 5 (Auth) - tối thiểu 16 ký tự
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
