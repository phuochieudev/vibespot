NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# Neon Postgres. DATABASE_URL: chuỗi pooled (dùng khi chạy app).
# DIRECT_URL: chuỗi direct, không qua pooler (tuỳ chọn, dùng cho prisma migrate).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# DIRECT_URL=postgresql://USER:PASSWORD@HOST-direct/DB?sslmode=require

# Bí mật ký JWT (tối thiểu 32 ký tự). Sinh bằng: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL_DAYS=30
